# Copiar a .env y ajustar valores.
# SQLite: la ruta es la que usa Prisma al ejecutar migraciones desde este directorio.

DATABASE_URL="file:./dev.db"

# Secreto para firmar tokens JWT. En producción usar un valor largo y aleatorio.
JWT_SECRET="workshop-dev-secret"

# Puerto del servidor Express (opcional; por defecto 3000).
# Si cambiás el puerto, actualizá también NEXT_PUBLIC_API_URL en el frontend.
# PORT=3000
